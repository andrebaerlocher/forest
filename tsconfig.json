{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	// `exclude` here replaces (does not merge with) whatever the base config
	// implies, so `node_modules` must be re-listed explicitly or it gets
	// type-checked too.
	//
	// `src/stories/**` is excluded because Storybook's `defineMeta<TSnippet,
	// TCmp>()` (from @storybook/addon-svelte-csf) is only fully resolved by
	// the addon's own Vite/Storybook build pipeline, which rewrites
	// `defineMeta`/`Story` usages before Svelte ever sees them. Under plain
	// tsc / svelte-check-native, outside that pipeline, `Story`'s inferred
	// props type can collapse to `{}` and template snippets referenced from
	// `<script module lang="ts">` (e.g. `render: FooTemplate`) can't be
	// resolved - this reproduces even for a bare `defineMeta({ component,
	// tags })` with no render/snippet at all, so it isn't a mistake in the
	// story files. Storybook itself type-checks and renders these stories
	// fine. This does not weaken checking of `src/lib` or `src/routes`,
	// which are unaffected and still fully type-checked; stories are
	// dev/docs-only and are never shipped in `dist`.
	"exclude": ["node_modules", "src/stories/**"]
}
